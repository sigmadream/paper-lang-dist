  "source": "#include <iostream>\n#include <functional>\n\nlong long solve(int n) {\n    int full = (1 << n) - 1;\n\n    std::function<long long(int, int, int, int)> go =\n        [&](int r, int cols, int d1, int d2) -> long long {\n            if (r == n) return 1;\n\n            long long total = 0;\n            int avail = full & ~(cols | d1 | d2);\n\n            while (avail) {\n                int b = avail & -avail;\n                avail ^= b;\n\n                total += go(\n                    r + 1,\n                    cols | b,\n                    ((d1 | b) << 1) & full,\n                    (d2 | b) >> 1\n                );\n            }\n\n            return total;\n        };\n\n    return go(0, 0, 0, 0);\n}\n\nint main() {\n    int n;\n    if (std::cin >> n) {\n        std::cout << solve(n) << '\\n';\n    }\n    return 0;\n}",
