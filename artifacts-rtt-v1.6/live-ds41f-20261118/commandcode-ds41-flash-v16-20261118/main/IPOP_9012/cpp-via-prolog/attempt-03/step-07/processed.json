{
  "source": "main :-\n    ( read_line_to_codes(user_input, FirstCodes),\n      FirstCodes \\== end_of_file ->\n        trim_codes(FirstCodes, TCodes),\n        ( TCodes == [] ->\n            true\n        ; ( catch(number_codes(T, TCodes), _, fail) ->\n              loop(T)\n          ; true\n          )\n        )\n    ; true\n    ).\n\nloop(0) :- !.\nloop(N) :-\n    N > 0,\n    read_line_to_codes(user_input, Line),\n    ( Line == end_of_file ->\n        true\n    ; trim_codes(Line, S),\n      ( valid_parens(S) ->\n          writeln('YES')\n      ; writeln('NO')\n      ),\n      N1 is N - 1,\n      loop(N1)\n    ).\n\ntrim_codes(Codes, Trimmed) :-\n    strip_leading_ws(Codes, C1),\n    reverse(C1, R1),\n    strip_leading_ws(R1, R2),\n    reverse(R2, Trimmed).\n\nstrip_leading_ws([C|Cs], Rest) :-\n    whitespace(C),\n    !,\n    strip_leading_ws(Cs, Rest).\nstrip_leading_ws(Cs, Cs).\n\nwhitespace(C) :-\n    C =:= 9\n    ; C =:= 10\n    ; C =:= 11\n    ; C =:= 12\n    ; C =:= 13\n    ; C =:= 32.\n\nvalid_parens(Codes) :-\n    Codes \\== [],\n    valid(Codes, 0).\n\nvalid([], 0).\nvalid([40|Cs], Bal) :-\n    Bal1 is Bal + 1,\n    valid(Cs, Bal1).\nvalid([41|Cs], Bal) :-\n    Bal > 0,\n    Bal1 is Bal - 1,\n    valid(Cs, Bal1).",
