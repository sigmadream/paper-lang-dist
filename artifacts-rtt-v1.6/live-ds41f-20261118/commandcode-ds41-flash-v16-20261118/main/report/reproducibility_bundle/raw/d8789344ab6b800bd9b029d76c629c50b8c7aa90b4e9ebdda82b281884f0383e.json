  "source": ":- use_module(library(lists)).\n\nmain :-\n    read_all_codes(Codes),\n    tokens(Codes, Tokens),\n    Tokens = [N|AllScores],\n    length(Scores, N),\n    append(Scores, _, AllScores),\n    solve(N, Scores, Ans),\n    format('~w~n', [Ans]).\n\nread_all_codes(Codes) :-\n    read_line_to_string(user_input, Line),\n    ( Line == end_of_file ->\n        Codes = []\n    ; string_codes(Line, LineCodes),\n      read_all_codes(Rest),\n      append(LineCodes, [10|Rest], Codes)\n    ).\n\ntokens(Codes, Tokens) :-\n    skip_ws(Codes, Rest),\n    ( Rest = [] ->\n        Tokens = []\n    ; take_token(Rest, TokenCodes, Rest1),\n      number_codes(Number, TokenCodes),\n      Tokens = [Number|More],\n      tokens(Rest1, More)\n    ).\n\nskip_ws([C|Cs], Rest) :-\n    is_ws(C), !,\n    skip_ws(Cs, Rest).\nskip_ws(Cs, Cs).\n\ntake_token([C|Cs], [C|Token], Rest) :-\n    \\+ is_ws(C), !,\n    take_token(Cs, Token, Rest).\ntake_token(Cs, [], Cs).\n\nis_ws(32).\nis_ws(9).\nis_ws(10).\nis_ws(13).\n\nsolve(N, Scores, Ans) :-\n    ( N =:= 1 ->\n        Scores = [S1|_],\n        Ans = S1\n    ; N =:= 2 ->\n        Scores = [S1,S2|_],\n        Ans is S1 + S2\n    ; build_dp(N, Scores, DP),\n      nth1(N, DP, Ans)\n    ).\n\nbuild_dp(N, Scores, DP) :-\n    Scores = [S1,S2|_],\n    D1 = S1,\n    D2 is S1 + S2,\n    dp_loop(3, N, Scores, 0, D1, D2, [D2,D1], RevDP),\n    reverse(RevDP, DP).\n\ndp_loop(I, N, Scores, DPrev3, DPrev2, DPrev1, Acc, RevDP) :-\n    ( I > N ->\n        RevDP = Acc\n    ; nth1(I, Scores, Si),\n      Im1 is I - 1,\n      nth1(Im1, Scores, Sim1),\n      ( DPrev2 >= DPrev3 + Sim1 ->\n          Best = DPrev2\n      ; Best is DPrev3 + Sim1\n      ),\n      Di is Best + Si,\n      I1 is I + 1,\n      dp_loop(I1, N, Scores, DPrev2, DPrev1, Di, [Di|Acc], RevDP)\n    ).",
