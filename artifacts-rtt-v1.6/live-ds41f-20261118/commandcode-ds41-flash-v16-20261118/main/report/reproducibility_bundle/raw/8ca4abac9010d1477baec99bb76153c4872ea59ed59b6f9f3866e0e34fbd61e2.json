  "source": "module Main where\n\nimport Data.List (foldl')\n\nmain :: IO ()\nmain = do\n    input <- getContents\n    let xs = map read (words input) :: [Integer]\n    case xs of\n        [] -> return ()\n        (n:rest) ->\n            let vals = take (fromIntegral n) rest\n            in if n == 0\n               then putStrLn \"0\"\n               else case vals of\n                   [] -> putStrLn \"0\"\n                   (v:vs) ->\n                       let (_, best) = foldl' step (v, v) vs\n                           step (cur, bestSoFar) x =\n                               let cur' = max x (cur + x)\n                                   best' = max bestSoFar cur'\n                               in (cur', best')\n                       in print best",
