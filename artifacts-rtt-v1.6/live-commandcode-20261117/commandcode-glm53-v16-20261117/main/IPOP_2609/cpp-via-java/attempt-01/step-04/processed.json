  "source": "#include <iostream>\nusing namespace std;\n\nint gcd(int a, int b) {\n    while (b != 0) {\n        int r = a % b;\n        a = b;\n        b = r;\n    }\n    return a;\n}\n\nint main() {\n    int a, b;\n    cin >> a >> b;\n    int g = gcd(a, b);\n    cout << g << \"\\n\" << (a / g) * b << \"\\n\";\n    return 0;\n}",
