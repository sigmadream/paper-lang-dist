  "source": "#include <iostream>\nusing namespace std;\n\nint n;\nlong long ans;\nbool col[15], diag1[30], diag2[30];\n\nvoid solve(int r) {\n    if (r == n) {\n        ++ans;\n        return;\n    }\n    for (int c = 0; c < n; ++c) {\n        int d1 = r + c;\n        int d2 = r - c + n - 1;\n        if (col[c] || diag1[d1] || diag2[d2]) continue;\n        col[c] = true;\n        diag1[d1] = true;\n        diag2[d2] = true;\n        solve(r + 1);\n        col[c] = false;\n        diag1[d1] = false;\n        diag2[d2] = false;\n    }\n}\n\nint main() {\n    if (!(cin >> n)) return 0;\n\n    ans = 0;\n    solve(0);\n\n    cout << ans << '\\n';\n    return 0;\n}",
