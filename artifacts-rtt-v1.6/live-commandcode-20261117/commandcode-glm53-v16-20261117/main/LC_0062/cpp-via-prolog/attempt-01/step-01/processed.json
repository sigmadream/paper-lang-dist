{
  "source": ":- use_module(library(readutil)).\n\nfact(0, 1) :- !.\nfact(N, F) :- N1 is N - 1, fact(N1, F1), F is N * F1.\n\ncomb(K, R, C) :-\n    R1 is K - R,\n    (   R1 < R\n    ->  comb(K, R1, C)\n    ;   fact(K, FK),\n        fact(R, FR),\n        fact(R1, FR1),\n        C is FK // (FR * FR1)\n    ).\n\nparse_ints([], [], []) :- !.\nparse_ints([32|T], Ns, Rest) :- !, parse_ints(T, Ns, Rest).\nparse_ints(Codes, [N|Ns], Rest) :-\n    (   number_codes(N, Digs),\n        append(Digs, Rest0, Codes)\n    ->  parse_ints(Rest0, Ns, Rest)\n    ;   Ns = [], Rest = Codes\n    ).\n\nmain :-\n    read_line_to_codes(user_input, Line),\n    (   Line == end_of_file\n    ->  true\n    ;   parse_ints(Line, [M, N], _),\n        K is M + N - 2,\n        R1 is M - 1,\n        R2 is N - 1,\n        (   R2 < R1\n        ->  R = R2\n        ;   R = R1\n        ),\n        comb(K, R, C),\n        number_codes(C, Out),\n        format(\"~s~n\", [Out])\n    ).",
