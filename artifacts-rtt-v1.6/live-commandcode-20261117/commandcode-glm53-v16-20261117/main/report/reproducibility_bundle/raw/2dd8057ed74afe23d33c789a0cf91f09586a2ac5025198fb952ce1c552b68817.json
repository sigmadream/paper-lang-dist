  "evaluation_status": "compile_error",
  "source": ":- use_module(library(readutil)).\n\nmain :-\n    catch(run, _, true).\n\nrun :-\n    read_line_to_codes(user_input, L),\n    ( L == end_of_file -> true\n    ; parse_two(L, M, N),\n      solve(M, N)\n    ).\n\nparse_two(L, M, N) :-\n    append_codes_num(L, Rest, M),\n    append_codes_num(Rest, _, N).\n\nappend_codes_num(L, Rest, Num) :-\n    skip_ws(L, L1),\n    collect_digits(L1, Rest, Ds),\n    number_codes(Num, Ds).\n\nskip_ws([C|T], R) :- ( C =:= 32 ; C =:= 9 ; C =:= 10 ; C =:= 13 ), !, skip_ws(T, R).\nskip_ws(L, L).\n\ncollect_digits([C|T], Rest, [C|Ds]) :-\n    C >= 48, C =< 57, !,\n    collect_digits(T, Rest, Ds).\ncollect_digits(L, L, []).\n\nsolve(M, N) :-\n    N1 is N + 1,\n    functor(Arr, a, N1 is N1,\n    init_arr(Arr, N1),\n    setarg(1, Arr, 0),\n    setarg(2, Arr, 0),\n    sieve(Arr, 2, N),\n    print_range(Arr, M, N).\n\ninit_arr(_, 0) :- !.\ninit_arr(Arr, K) :-\n    setarg(K, Arr, 1),\n    K1 is K - 1,\n    init_arr(Arr, K1).\n\nsieve(Arr, I, N) :-\n    I * I =< N, !,\n    K is I + 1,\n    ( arg(K, Arr, 1) ->\n        S is I * I,\n        mark(Arr, S, I, N)\n    ; true\n    ),\n    I1 is I + 1,\n    sieve(Arr, I1, N).\nsieve(_, _, _).\n\nmark(Arr, J, I, N) :-\n    J =< N, !,\n    K is J + 1,\n    setarg(K, Arr, 0),\n    J1 is J + I,\n    mark(Arr, J1, I, N).\nmark(_, _, _, _).\n\nprint_range(Arr, M, N) :-\n    M =< N, !,\n    K is M + 1,\n    ( arg(K, Arr, 1) ->\n        format(\"~d~n\", [M])\n    ; true\n    ),\n    M1 is M + 1,\n    print_range(Arr, M1, N).\nprint_range(_, _, _).",
