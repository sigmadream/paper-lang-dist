{
  "source": "module Main where\n\nsolve :: [String] -> Int -> Int -> Int -> String\nsolve grid r c size =\n    let first = (grid !! r) !! c\n        same = all (\\i -> all (\\j -> (grid !! i) !! j == first) [c .. c + size - 1]) [r .. r + size - 1]\n    in if same\n        then [first]\n        else\n            let half = size `div` 2\n            in \"(\"\n               ++ solve grid r c half\n               ++ solve grid r (c + half) half\n               ++ solve grid (r + half) c half\n               ++ solve grid (r + half) (c + half) half\n               ++ \")\"\n\nmain :: IO ()\nmain = do\n    input <- getContents\n    case words input of\n        [] -> return ()\n        (nStr:rest) -> do\n            let n = read nStr :: Int\n                grid = take n rest\n            putStrLn (solve grid 0 0 n)",
