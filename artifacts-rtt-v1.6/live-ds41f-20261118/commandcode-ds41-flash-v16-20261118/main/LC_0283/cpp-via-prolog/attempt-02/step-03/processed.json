{
  "source": "main :-\n    (   read(N),\n        integer(N)\n    ->  read_numbers(N, Nums),\n        move_zeroes(Nums, Result),\n        write_numbers(Result)\n    ;   nl\n    ).\n\nread_numbers(0, []) :- !.\nread_numbers(N, [X|Xs]) :-\n    N > 0,\n    read(X),\n    N1 is N - 1,\n    read_numbers(N1, Xs).\n\nmove_zeroes(Nums, Result) :-\n    split_zeroes(Nums, NonZeroes, ZeroCount),\n    length(Zeros, ZeroCount),\n    append(NonZeroes, Zeros, Result).\n\nsplit_zeroes([], [], 0).\nsplit_zeroes([X|Xs], NonZeroes, ZeroCount) :-\n    split_zeroes(Xs, Rest, RestZeroCount),\n    (   X =:= 0\n    ->  NonZeroes = Rest,\n        ZeroCount is RestZeroCount + 1\n    ;   NonZeroes = [X|Rest],\n        ZeroCount = RestZeroCount\n    ).\n\nwrite_numbers([]) :- nl.\nwrite_numbers([X|Xs]) :-\n    write(X),\n    write_tail(Xs).\n\nwrite_tail([]) :- nl.\nwrite_tail([X|Xs]) :-\n    write(' '),\n    write(X),\n    write_tail(Xs).",
