{
  "source": "#include <iostream>\n#include <vector>\n#include <queue>\n\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int N, M;\n    if (!(cin >> N >> M)) {\n        return 0;\n    }\n\n    vector<vector<int>> adj(N + 1);\n\n    for (int i = 0; i < M; ++i) {\n        int a, b;\n        if (!(cin >> a >> b)) {\n            return 0;\n        }\n        if (a >= 1 && a <= N && b >= 1 && b <= N) {\n            adj[a].push_back(b);\n            adj[b].push_back(a);\n        }\n    }\n\n    if (N < 1) {\n        return 0;\n    }\n\n    vector<int> dist(N + 1, -1);\n    queue<int> q;\n\n    dist[1] = 0;\n    q.push(1);\n\n    while (!q.empty()) {\n        int cur = q.front();\n        q.pop();\n\n        for (int nxt : adj[cur]) {\n            if (dist[nxt] == -1) {\n                dist[nxt] = dist[cur] + 1;\n                q.push(nxt);\n            }\n        }\n    }\n\n    int answer = 0;\n    for (int v = 2; v <= N; ++v) {\n        if (dist[v] == 1 || dist[v] == 2) {\n            ++answer;\n        }\n    }\n\n    cout << answer << '\\n';\n    return 0;\n}",
