  "source": ":- use_module(library(lists)).\n\nmain :-\n    read_all_codes(Codes),\n    codes_to_ints(Codes, Ints),\n    Ints = [N|ScoreTokens],\n    length(Scores, N),\n    append(Scores, _, ScoreTokens),\n    solve(N, Scores, Ans),\n    format('~d~n', [Ans]).\n\nread_all_codes(Codes) :-\n    read_codes(Codes).\n\nread_codes(Codes) :-\n    get_code(user_input, C),\n    (   C =:= -1\n    ->  Codes = []\n    ;   Codes = [C|Rest],\n        read_codes(Rest)\n    ).\n\ncodes_to_ints(Codes, Ints) :-\n    codes_to_ints(Codes, [], Ints).\n\ncodes_to_ints([], Acc, Ints) :-\n    (   Acc = []\n    ->  Ints = []\n    ;   reverse(Acc, Rev),\n        digits_value(Rev, N),\n        Ints = [N]\n    ).\ncodes_to_ints([C|Cs], Acc, Ints) :-\n    C >= 48,\n    C =< 57,\n    !,\n    codes_to_ints(Cs, [C|Acc], Ints).\ncodes_to_ints([_|Cs], Acc, Ints) :-\n    (   Acc = []\n    ->  codes_to_ints(Cs, [], Ints)\n    ;   reverse(Acc, Rev),\n        digits_value(Rev, N),\n        Ints = [N|Rest],\n        codes_to_ints(Cs, [], Rest)\n    ).\n\ndigits_value(Digits, Value) :-\n    digits_value(Digits, 0, Value).\n\ndigits_value([], V, V).\ndigits_value([D|Ds], Acc, V) :-\n    Acc1 is Acc * 10 + (D - 48),\n    digits_value(Ds, Acc1, V).\n\nsolve(N, Scores, Ans) :-\n    N =:= 1,\n    !,\n    Scores = [S1|_],\n    Ans = S1.\nsolve(N, Scores, Ans) :-\n    N =:= 2,\n    !,\n    Scores = [S1, S2|_],\n    Ans is S1 + S2.\nsolve(N, Scores, Ans) :-\n    Scores = [S1, S2|_],\n    A = 0,\n    B = S1,\n    C is S1 + S2,\n    loop(3, N, Scores, A, B, C, Ans).\n\nloop(I, N, Scores, A, B, C, Ans) :-\n    (   I > N\n    ->  Ans = C\n    ;   nth1(I, Scores, Si),\n        Iprev is I - 1,\n        nth1(Iprev, Scores, Sprev),\n        X is A + Sprev,\n        (   B >= X\n        ->  M = B\n        ;   M = X\n        ),\n        D is M + Si,\n        A1 = B,\n        B1 = C,\n        C1 = D,\n        I2 is I + 1,\n        loop(I2, N, Scores, A1, B1, C1, Ans)\n    ).",
