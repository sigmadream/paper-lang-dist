  "source": "module Main (main) where\n\nimport Data.List (foldl')\n\nmain :: IO ()\nmain = do\n  contents <- getContents\n  let (nStr : rest) = contentsLine\n      n = read nStr :: Int\n      scores = map read (take n rest) :: [Int]\n      s = 0 : scores -- 1-indexed\n      dp = scanl step 0 [1 .. n]\n      step _ i\n        | i == 1 = s !! 1\n        | i == 2 = s !! 1 + s !! 2\n        | otherwise = max (dp !! (i - 2)) (dp !! (i - 3) + s !! (i - 1)) + s !! i\n  print (last dp)",
