  "source": "module Main (main) where\n\nimport Data.List (foldl')\n\nmain :: IO ()\nmain = do\n  line <- getLine\n  let [m, n] = map read (words line) :: [Int]\n      row = replicate n 1\n      step dp = scanl1 (+) dp\n      dp = foldl' (\\acc _ -> step acc) row [1 .. m - 1]\n  print (last dp)",
