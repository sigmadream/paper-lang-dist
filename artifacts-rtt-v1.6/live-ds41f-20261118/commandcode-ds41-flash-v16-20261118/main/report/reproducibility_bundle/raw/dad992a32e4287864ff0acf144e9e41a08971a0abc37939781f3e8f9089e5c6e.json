  "source": "#include <iostream>\n#include <string>\n#include <vector>\n\nusing namespace std;\n\nstring solve(const vector<string>& grid, int r, int c, int size) {\n    char first = grid[r][c];\n    bool same = true;\n\n    for (int i = r; i < r + size && same; ++i) {\n        for (int j = c; j < c + size; ++j) {\n            if (grid[i][j] != first) {\n                same = false;\n                break;\n            }\n        }\n    }\n\n    if (same) {\n        return string(1, first);\n    }\n\n    int half = size / 2;\n    return \"(\"\n        + solve(grid, r, c, half)\n        + solve(grid, r, c + half, half)\n        + solve(grid, r + half, c, half)\n        + solve(grid, r + half, c + half, half)\n        + \")\";\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    if (!(cin >> n)) return 0;\n\n    vector<string> grid(n);\n    for (int i = 0; i < n; ++i) {\n        cin >> grid[i];\n    }\n\n    cout << solve(grid, 0, 0, n) << '\\n';\n\n    return 0;\n}",
