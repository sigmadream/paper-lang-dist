  "source": "#include <bits/stdc++.h>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    if (!(cin >> n)) return 0;\n\n    vector<int> score(n + 1, 0);\n    vector<int> dp(n + 1, 0);\n\n    for (int i = 1; i <= n; ++i) {\n        cin >> score[i];\n    }\n\n    if (n >= 1) {\n        dp[1] = score[1];\n    }\n    if (n >= 2) {\n        dp[2] = score[1] + score[2];\n    }\n\n    for (int i = 3; i <= n; ++i) {\n        dp[i] = max(dp[i - 2], dp[i - 3] + score[i - 1]) + score[i];\n    }\n\n    cout << dp[n] << '\\n';\n    return 0;\n}",
