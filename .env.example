# Copy to `.env` (git-ignored) and fill in real values.
# `.env` is read by scripts/experiment-env.ps1 and exported into the shell process.
# NEVER put these values in fps_v2*.yaml or in a tracked script.

# Primary key used by fps_v2.yaml (api_key_env: RTT_API_KEY)
RTT_API_KEY=

# Optional: separate keys per provider, referenced via make_model_config.py --api-key-env
# ZAI_API_KEY=
# DEEPSEEK_API_KEY=

# v1.6 공급자별 인증값입니다. yaml에는 환경 변수 이름만 기록해 주세요.
OPENAI_API_KEY=
ZAI_API_KEY=
# Coding Plan을 별도 설정하시는 경우에만 사용해 주세요.
ZAI_CODING_API_KEY=
OPENCODE_API_KEY=
OPENCODE_GO_API_KEY=
# 공식 Copilot SDK에 명시적으로 전달하는 인증 토큰입니다.
COPILOT_GITHUB_TOKEN=
