  "source": "#include <iostream>\n#include <string>\n#include <array>\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n\n    auto readLine = []() {\n        std::string line;\n        if (!std::getline(std::cin, line)) {\n            line = \"\";\n        }\n        if (!line.empty() && line.back() == '\\r') {\n            line.pop_back();\n        }\n        return line;\n    };\n\n    std::string s = readLine();\n    std::string t = readLine();\n\n    std::array<int, 26> counts{};\n\n    for (char ch : s) {\n        counts[ch - 'a']++;\n    }\n    for (char ch : t) {\n        counts[ch - 'a']--;\n    }\n\n    bool valid = true;\n    for (int c : counts) {\n        if (c != 0) {\n            valid = false;\n            break;\n        }\n    }\n\n    std::cout << (valid ? 1 : 0) << '\\n';\n\n    return 0;\n}",
