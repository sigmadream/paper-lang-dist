  "source": "module Main where\n\nimport qualified Data.Set as Set\nimport Data.List (foldl')\n\nmain :: IO ()\nmain = do\n    input <- getContents\n    let nums = map read (words input) :: [Int]\n    case nums of\n        (n:m:rest) ->\n            if n <= 0\n                then putStrLn \"0\"\n                else do\n                    let edges = take m rest\n                    let adj = buildAdj n edges\n                    let d1 = Set.fromList (adj !! 0)\n                    let d2 = Set.fromList\n                            [ w\n                            | v <- Set.toList d1\n                            , w <- adj !! v\n                            , w /= 0\n                            , not (Set.member w d1)\n                            ]\n                    print (Set.size d1 + Set.size d2)\n        _ -> return ()\n\nbuildAdj :: Int -> [Int] -> [[Int]]\nbuildAdj n xs = go (replicate n []) xs\n  where\n    go adj (a:b:rest) =\n        let a' = a - 1\n            b' = b - 1\n            adj1 = update adj a' b'\n            adj2 = update adj1 b' a'\n        in go adj2 rest\n    go adj _ = adj\n\n    update adj i v =\n        [ if j == i then v : adj !! j else adj !! j\n        | j <- [0 .. length adj - 1]\n        ]",
