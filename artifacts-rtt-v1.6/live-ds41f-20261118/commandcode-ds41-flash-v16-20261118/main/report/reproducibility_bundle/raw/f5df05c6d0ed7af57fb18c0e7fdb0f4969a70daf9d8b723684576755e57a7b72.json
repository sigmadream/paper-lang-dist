  "source": "#include <iostream>\n#include <string>\n\nint main() {\n    std::string s;\n    std::getline(std::cin, s);\n\n    if (!s.empty() && s.back() == '\\r') {\n        s.pop_back();\n    }\n\n    bool palindrome = true;\n    int left = 0;\n    int right = static_cast<int>(s.size()) - 1;\n\n    while (left < right) {\n        if (s[left] != s[right]) {\n            palindrome = false;\n            break;\n        }\n        ++left;\n        --right;\n    }\n\n    std::cout << (palindrome ? 1 : 0) << '\\n';\n    return 0;\n}",
