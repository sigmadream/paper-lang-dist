  "source": "main :-\n    current_input(Stream),\n    read_string(Stream, end_of_file, Input),\n    string_codes(Input, Codes),\n    parse_n(Codes, N),\n    ( N < 0 ->\n        nl\n    ;\n        output_range(0, N)\n    ).\n\nparse_n(Codes, N) :-\n    skip_ws(Codes, Rest),\n    parse_digits(Rest, 0, N).\n\nskip_ws([C|T], R) :-\n    ws(C),\n    skip_ws(T, R).\nskip_ws(L, L).\n\nws(32).\nws(9).\nws(10).\nws(13).\n\nparse_digits([C|T], Acc, N) :-\n    C >= 48,\n    C =< 57,\n    !,\n    Acc1 is Acc * 10 + (C - 48),\n    parse_digits(T, Acc1, N).\nparse_digits(_, Acc, Acc).\n\noutput_range(I, N) :-\n    I > N,\n    !,\n    nl.\noutput_range(I, N) :-\n    ( I > 0 ->\n        write(' ')\n    ;\n        true\n    ),\n    popcount(I, P),\n    write(P),\n    I1 is I + 1,\n    output_range(I1, N).\n\npopcount(X, C) :-\n    X =:= 0,\n    !,\n    C = 0.\npopcount(X, C) :-\n    X > 0,\n    X1 is X >> 1,\n    popcount(X1, C1),\n    C is (X mod 2) + C1.",
