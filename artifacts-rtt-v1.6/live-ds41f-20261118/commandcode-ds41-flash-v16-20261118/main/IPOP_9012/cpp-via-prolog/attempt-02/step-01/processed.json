{
  "source": "is_ws(C) :-\n    char_code(C, Code),\n    ( Code =:= 32\n    ; Code =:= 9\n    ; Code =:= 10\n    ; Code =:= 13\n    ; Code =:= 12\n    ; Code =:= 11\n    ).\n\nskip_ws(end_of_file, end_of_file) :- !.\nskip_ws(C, C1) :-\n    is_ws(C), !,\n    get_char(NC),\n    skip_ws(NC, C1).\nskip_ws(C, C).\n\nread_token(Tok) :-\n    get_char(C),\n    skip_ws(C, C1),\n    ( C1 == end_of_file ->\n        Tok = end_of_file\n    ; read_token_chars(C1, Chars),\n      atom_chars(Tok, Chars)\n    ).\n\nread_token_chars(end_of_file, []) :- !.\nread_token_chars(C, []) :-\n    is_ws(C), !.\nread_token_chars(C, [C|Rest]) :-\n    get_char(NC),\n    read_token_chars(NC, Rest).\n\nvalid_paren(S) :-\n    atom_chars(S, Chars),\n    check(Chars, 0).\n\ncheck([], Bal) :-\n    Bal =:= 0.\ncheck(['('|Rest], Bal) :-\n    Bal1 is Bal + 1,\n    check(Rest, Bal1).\ncheck([')'|Rest], Bal) :-\n    Bal > 0,\n    Bal1 is Bal - 1,\n    check(Rest, Bal1).\n\nprocess(0) :- !.\nprocess(T) :-\n    T > 0,\n    read_token(S),\n    ( S == end_of_file ->\n        true\n    ; valid_paren(S) ->\n        write('YES'), nl\n    ; write('NO'), nl\n    ),\n    T1 is T - 1,\n    process(T1).\n\nmain :-\n    read_token(Tok),\n    ( Tok == end_of_file ->\n        true\n    ; atom_number(Tok, T),\n      process(T)\n    ).",
