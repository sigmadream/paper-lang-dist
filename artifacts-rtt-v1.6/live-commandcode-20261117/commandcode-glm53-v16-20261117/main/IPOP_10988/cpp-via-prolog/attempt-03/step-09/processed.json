{
  "source": ":- module(main, [main/0]).\n:- use_module(library(dcgs)).\n\nreverse_s([], []).\nreverse_s([H|T], R) :- reverse_s(T, RT), append(RT, [H], R).\n\nmain :-\n    read_line_to_string(user_input, S),\n    ( string_length(S, L), L > 0,\n      sub_string(S, L-1, 1, _, \"\\r\") ->\n        SL is L - 1, sub_string(S, 0, SL, _, S2)\n    ; S2 = S\n    ),\n    string_codes(S2, Cs),\n    reverse_s(Cs, R),\n    ( Cs == R -> Rslt = 1 ; Rslt = 0 ),\n    format(\"~d~n\", [Rslt]).",
