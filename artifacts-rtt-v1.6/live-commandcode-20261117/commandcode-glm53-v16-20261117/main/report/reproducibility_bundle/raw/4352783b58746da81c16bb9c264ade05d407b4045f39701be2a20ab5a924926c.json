  "evaluation_status": "runtime_error",
  "source": ":- module(main, [main/0]).\n:- set_prolog_flag(verbose, silent).\n\nmain :-\n    read_line_to(user_input, L1),\n    ( L1 == end_of_file -> true\n    ; atom_number(L1, N),\n      read_line_to(user_input, L2),\n      ( L2 == end_of_file -> M = 0\n      ; atom_number(L2, M)\n      ),\n      read_edges(M, Edges),\n      assertz(n(N)),\n      forall(member(u(A,B), Edges),\n             ( assertz(e(A,B)), assertz(e(B,A)) )),\n      findall(V,\n              ( between(1, N, V),\n                V \\= 1,\n                ( e(1, V)\n                ; e(1, W), e(W, V), W \\= V\n                ) ),\n              Vs),\n      sort(Vs, Sorted),\n      length(Sorted, Ans),\n      write(Ans), nl,\n      retractall(e(_, _)),\n      retractall(n(_))\n    ),\n    halt.\n\nread_edges(0, []) :- !.\nread_edges(M, [E|Es]) :-\n    read_line_to(user_input, Line),\n    ( Line == end_of_file -> E = u(0,0), Es = []\n    ; split_string(Line, \" \", \" \", Parts),\n      maplist(atom_number, Parts, [A, B]),\n      E = u(A, B),\n      M1 is M - 1,\n      read_edges(M1, Es)\n    ).",
