  "source": "#include <iostream>\n#include <vector>\n#include <queue>\n\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n\n    vector<vector<int>> adj(n + 1);\n\n    for (int i = 0; i < m; ++i) {\n        int u, v;\n        cin >> u >> v;\n        adj[u].push_back(v);\n        adj[v].push_back(u);\n    }\n\n    vector<int> dist(n + 1, -1);\n    queue<int> q;\n\n    dist[1] = 0;\n    q.push(1);\n\n    int ans = 0;\n\n    while (!q.empty()) {\n        int curr = q.front();\n        q.pop();\n\n        for (int nxt : adj[curr]) {\n            if (dist[nxt] == -1) {\n                dist[nxt] = dist[curr] + 1;\n                q.push(nxt);\n\n                if (dist[nxt] <= 2) {\n                    ++ans;\n                }\n            }\n        }\n    }\n\n    cout << ans << '\\n';\n\n    return 0;\n}",
