{
  "source": ":- use_module(library(readutil)).\n\nread_pair(M, N) :-\n    read_line_to_string(user_input, Line),\n    split_string(Line, \" \\t\\r\\n\", \" \\t\\r\\n\", Tokens),\n    Tokens = [A, B | _],\n    number_string(M, A),\n    number_string(N, B).\n\nnext_row([], _, Acc, Row) :-\n    reverse(Acc, Row).\nnext_row([X | Xs], Left, Acc, Row) :-\n    Y is X + Left,\n    next_row(Xs, Y, [Y | Acc], Row).\n\nnext_row(Row, NewRow) :-\n    Row = [First | Rest],\n    next_row(Rest, First, [First], NewRow).\n\niterate_rows(0, Row, Row).\niterate_rows(K, Row, Final) :-\n    K > 0,\n    next_row(Row, NewRow),\n    K1 is K - 1,\n    iterate_rows(K1, NewRow, Final).\n\nunique_paths(M, N, Ans) :-\n    length(Row, N),\n    maplist(=(1), Row),\n    M1 is M - 1,\n    iterate_rows(M1, Row, Final),\n    last(Final, Ans).\n\nmain :-\n    read_pair(M, N),\n    unique_paths(M, N, Ans),\n    format(\"~w~n\", [Ans]).",
