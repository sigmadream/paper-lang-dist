  "source": "import java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static int n;\n    static long ans = 0;\n    static boolean[] col, diag1, diag2;\n\n    static void solve(int r) {\n        if (r == n) { ans++; return; }\n        for (int c = 0; c < n; c++) {\n            if (col[c] || diag1[r + c] || diag2[r - c + n - 1]) continue;\n            col[c] = diag1[r + c] = diag2[r - c + n - 1] = true;\n            solve(r + 1);\n            col[c] = diag1[r + c] = diag2[r - c + n - 1] = false;\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String line = br.readLine();\n        if (line == null) return;\n        StringBuilder trimmed = new StringBuilder();\n        for (char ch : line.toCharArray())\n            if (!Character.isWhitespace(ch)) trimmed.append(ch);\n        if (trimmed.length() == 0) return;\n        n = Integer.parseInt(trimmed.toString());\n        col = new boolean[n];\n        diag1 = new boolean[2 * n - 1];\n        diag2 = new boolean[2 * n - 1];\n        solve(0);\n        System.out.println(ans);\n    }\n}",
