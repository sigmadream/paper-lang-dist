  "source": "#include <iostream>\n#include <string>\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n\n    int T;\n    if (!(std::cin >> T)) return 0;\n\n    std::cin.ignore(1000000, '\\n');\n\n    for (int i = 0; i < T; ++i) {\n        std::string s;\n        std::getline(std::cin, s);\n\n        int balance = 0;\n        bool valid = true;\n\n        for (char c : s) {\n            if (c == '(') {\n                ++balance;\n            } else if (c == ')') {\n                --balance;\n                if (balance < 0) {\n                    valid = false;\n                    break;\n                }\n            }\n        }\n\n        if (balance != 0) valid = false;\n\n        std::cout << (valid ? \"YES\" : \"NO\") << '\\n';\n    }\n\n    return 0;\n}",
