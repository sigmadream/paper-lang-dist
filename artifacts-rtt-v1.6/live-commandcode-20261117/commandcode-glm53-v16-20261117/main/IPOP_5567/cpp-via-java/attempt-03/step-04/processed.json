  "source": "#include <bits/stdc++.h>\nusing namespace std;\n\nint main() {\n    int n, m;\n    if (scanf(\"%d %d\", &n, &m) != 2) { printf(\"0\\n\"); return 0; }\n    vector<vector<int>> adj(n + 1);\n    for (int i = 0; i < m; i++) {\n        int u, v;\n        scanf(\"%d %d\", &u, &v);\n        adj[u].push_back(v);\n        adj[v].push_back(u);\n    }\n    vector<int> dist(n + 1, -1);\n    queue<int> q;\n    q.push(1);\n    dist[1] = 0;\n    int ans = 0;\n    while (!q.empty()) {\n        int curr = q.front(); q.pop();\n        for (int next : adj[curr]) {\n            if (dist[next] == -1) {\n                dist[next] = dist[curr] + 1;\n                q.push(next);\n                if (dist[next] <= 2) ans++;\n            }\n        }\n    }\n    printf(\"%d\\n\", ans);\n    return 0;\n}",
