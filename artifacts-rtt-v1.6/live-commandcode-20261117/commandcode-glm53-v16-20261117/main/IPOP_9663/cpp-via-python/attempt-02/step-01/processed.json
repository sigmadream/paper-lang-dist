{
  "source": "import sys\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    ans = 0\n    col = [False] * n\n    diag1 = [False] * (2 * n - 1)\n    diag2 = [False] * (2 * n - 1)\n\n    def solve(r):\n        nonlocal ans\n        if r == n:\n            ans += 1\n            return\n        for c in range(n):\n            if col[c] or diag1[r + c] or diag2[r - c + n - 1]:\n                continue\n            col[c] = diag1[r + c] = diag2[r - c + n - 1] = True\n            solve(r + 1)\n            col[c] = diag1[r + c] = diag2[r - c + n - 1] = False\n\n    solve(0)\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()",
