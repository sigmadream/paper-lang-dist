{
  "source": "main :-\n    read_line_to_string(user_input, Line),\n    ( Line == end_of_file ->\n        N = 0\n    ;\n        parse_line(Line, N)\n    ),\n    print_counts(N).\n\nparse_line(Line, N) :-\n    string_chars(Line, Chars),\n    include(valid_char, Chars, Filtered),\n    ( Filtered = [] ->\n        N = 0\n    ;\n        maplist(char_code, Filtered, Codes),\n        ( catch(number_codes(N0, Codes), _, fail) ->\n            N = N0\n        ;\n            N = 0\n        )\n    ).\n\nvalid_char(C) :-\n    C == '-' ;\n    ( C >= '0',\n      C =< '9'\n    ).\n\nprint_counts(N) :-\n    forall(\n        between(0, N, I),\n        (\n            ( I > 0 -> write(' ') ; true ),\n            count_bits(I, C),\n            write(C)\n        )\n    ),\n    nl.\n\ncount_bits(N, C) :-\n    count_bits(N, 0, C).\n\ncount_bits(0, Acc, Acc) :- !.\ncount_bits(N, Acc, C) :-\n    N > 0,\n    Acc1 is Acc + (N mod 2),\n    M is N // 2,\n    count_bits(M, Acc1, C).",
