{
  "source": "import sys\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    if not data:\n        return\n\n    n, c = data[0], data[1]\n    houses = data[2:2 + n]\n    houses.sort()\n\n    left = 1\n    right = houses[-1] - houses[0]\n    ans = 0\n\n    while left <= right:\n        mid = left + (right - left) // 2\n        count = 1\n        prev = houses[0]\n\n        for i in range(1, n):\n            if houses[i] - prev >= mid:\n                count += 1\n                prev = houses[i]\n\n        if count >= c:\n            ans = mid\n            left = mid + 1\n        else:\n            right = mid - 1\n\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()",
