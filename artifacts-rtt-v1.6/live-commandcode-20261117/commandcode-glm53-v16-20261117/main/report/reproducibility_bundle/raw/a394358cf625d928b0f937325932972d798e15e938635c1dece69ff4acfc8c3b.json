  "source": "#include <bits/stdc++.h>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, c;\n    cin >> n >> c;\n    vector<long long> a(n);\n    for (int i = 0; i < n; i++) cin >> a[i];\n\n    sort(a.begin(), a.end());\n\n    long long l = 1, r = a[n - 1] - a[0], ans = 0;\n    while (l <= r) {\n        long long mid = l + (r - l) / 2;\n        int count = 1;\n        long long prev = a[0];\n        for (int i = 1; i < n; i++) {\n            if (a[i] - prev >= mid) {\n                count++;\n                prev = a[i];\n            }\n        }\n        if (count >= c) {\n            ans = mid;\n            l = mid + 1;\n        } else {\n            r = mid - 1;\n        }\n    }\n\n    cout << ans << \"\\n\";\n    return 0;\n}",
