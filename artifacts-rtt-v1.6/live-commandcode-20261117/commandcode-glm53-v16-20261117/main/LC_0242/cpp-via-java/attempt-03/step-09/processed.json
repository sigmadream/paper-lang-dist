{
  "source": "import java.io.*;\n\npublic class Main {\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String s = br.readLine();\n        String t = br.readLine();\n        if (s == null) s = \"\";\n        if (t == null) t = \"\";\n        s = trim(s);\n        t = trim(t);\n        int[] counts = new int[26];\n        for (char c : s.toCharArray()) counts[c - 'a']++;\n        for (char c : t.toCharArray()) counts[c - 'a']--;\n        boolean ok = true;\n        for (int x : counts) if (x != 0) { ok = false; break; }\n        System.out.println(ok ? 1 : 0);\n    }\n\n    private static String trim(String str) {\n        int a = 0, z = str.length() - 1;\n        while (a <= z && isSpace(str.charAt(a))) a++;\n        while (z >= a && isSpace(str.charAt(z))) z--;\n        return a > z ? \"\" : str.substring(a, z + 1);\n    }\n\n    private static boolean isSpace(char c) {\n        return c == ' ' || c == '\\t' || c == '\\r' || c == '\\n';\n    }\n}",
