  "source": "#include <iostream>\n#include <vector>\n#include <algorithm>\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n\n    int n;\n    if (!(std::cin >> n)) return 0;\n\n    std::vector<int> scores(n + 1, 0);\n    for (int i = 1; i <= n; ++i) {\n        std::cin >> scores[i];\n    }\n\n    std::vector<int> dp(n + 1, 0);\n\n    if (n >= 1) dp[1] = scores[1];\n    if (n >= 2) dp[2] = scores[1] + scores[2];\n\n    for (int i = 3; i <= n; ++i) {\n        dp[i] = std::max(dp[i - 2], dp[i - 3] + scores[i - 1]) + scores[i];\n    }\n\n    std::cout << dp[n] << '\\n';\n    return 0;\n}",
