  "source": "import sys\nfrom collections import deque\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    if len(data) < 2:\n        return\n\n    n, m = data[0], data[1]\n    adj = [[] for _ in range(n + 1)]\n\n    idx = 2\n    for _ in range(m):\n        u, v = data[idx], data[idx + 1]\n        idx += 2\n        adj[u].append(v)\n        adj[v].append(u)\n\n    dist = [-1] * (n + 1)\n    if n >= 1:\n        dist[1] = 0\n\n    q = deque([1]) if n >= 1 else deque()\n    ans = 0\n\n    while q:\n        curr = q.popleft()\n\n        for nxt in adj[curr]:\n            if dist[nxt] == -1:\n                dist[nxt] = dist[curr] + 1\n                q.append(nxt)\n\n                if dist[nxt] <= 2:\n                    ans += 1\n\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()",
