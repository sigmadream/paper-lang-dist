{
  "source": ":- use_module(library(readutil)).\n\nmain :-\n    read_tokens(Tokens),\n    Tokens = [NStr|Rest],\n    number_string(N, NStr),\n    take(N, Rest, ScoreStrList),\n    maplist(number_string, Scores, ScoreStrList),\n    solve(Scores, Answer),\n    writeln(Answer).\n\nread_tokens(Tokens) :-\n    read_tokens_rev([], Rev),\n    reverse(Rev, Tokens).\n\nread_tokens_rev(Acc, Rev) :-\n    read_line_to_string(user_input, Line),\n    ( Line == end_of_file ->\n        Rev = Acc\n    ; split_string(Line, \" \\t\\r\\n\", \" \\t\\r\\n\", Ts),\n      reverse(Ts, RevTs),\n      append(RevTs, Acc, Acc2),\n      read_tokens_rev(Acc2, Rev)\n    ).\n\ntake(0, _, []) :- !.\ntake(N, [X|Xs], [X|Ys]) :-\n    N > 0,\n    N1 is N - 1,\n    take(N1, Xs, Ys).\n\nsolve(Scores, Answer) :-\n    length(Scores, N),\n    ( N =:= 1 ->\n        nth1(1, Scores, Answer)\n    ; N =:= 2 ->\n        nth1(1, Scores, S1),\n        nth1(2, Scores, S2),\n        Answer is S1 + S2\n    ; nth1(1, Scores, S1),\n      nth1(2, Scores, S2),\n      DP2 is S1 + S2,\n      DP = [S1, DP2],\n      compute(3, N, Scores, DP, Answer)\n    ).\n\ncompute(I, N, _, DP, Answer) :-\n    I > N,\n    !,\n    reverse(DP, [Answer|_]).\ncompute(I, N, Scores, DP, Answer) :-\n    nth1(I, Scores, Si),\n    SPrevIdx is I - 1,\n    nth1(SPrevIdx, Scores, SPrev),\n    ( I =:= 3 ->\n        nth1(1, DP, DP1),\n        max_num(DP1, SPrev, Candidate)\n    ; Idx2 is I - 2,\n      Idx3 is I - 3,\n      nth1(Idx2, DP, DP_i2),\n      nth1(Idx3, DP, DP_i3),\n      Tmp is DP_i3 + SPrev,\n      max_num(DP_i2, Tmp, Candidate)\n    ),\n    NewDP is Candidate + Si,\n    append(DP, [NewDP], DP2),\n    I1 is I + 1,\n    compute(I1, N, Scores, DP2, Answer).\n\nmax_num(A, B, M) :-\n    ( A >= B -> M = A ; M = B ).",
