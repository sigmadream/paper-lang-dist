  "source": ":- module(main, [main/0]).\n:- set_prolog_flag(double_quotes, atom).\n\nmain :-\n    read_line_to_codes(user_input, L1),\n    parse_int(L1, N),\n    read_scores(N, Scores0),\n    reverse(Scores0, Scores), % Scores: stair 1..N in order\n    length(Scores, N),\n    solve(N, Scores, Ans),\n    format(\"~d~n\", [Ans]).\n\nread_scores(0, []) :- !.\nread_scores(N, [S|Rest]) :-\n    read_line_to_codes(user_input, L),\n    parse_int(L, S),\n    N1 is N - 1,\n    read_scores(N1, Rest).\n\nparse_int(L, X) :-\n    number_codes(X, L).\n\nsolve(N, Scores, Ans) :-\n    length(Dp, N),\n    fill_dp(N, Scores, Dp),\n    nth1(N, Dp, Ans).\n\nfill_dp(1, [S1], [S1]) :- !.\nfill_dp(2, [S1, S2], [D1, D2]) :- !,\n    D1 is S1,\n    D2 is S1 + S2.\nfill_dp(N, Scores, Dp) :-\n    N >= 3,\n    Nm1 is N - 1,\n    Nm2 is N - 2,\n    Nm3 is N - 3,\n    fill_dp(Nm1, Scores, Dp1),\n    nth1(Nm1, Dp1, Dm1),\n    nth1(Nm2, Dp1, Dm2),\n    nth1(Nm3, Dp1, Dm3),\n    nth1(N, Scores, SN),\n    nth1(Nm1, Scores, SNm1),\n    D is max(Dm2, Dm3 + SNm1) + SN,\n    append(Dp1, [D], Dp).",
