  "source": ":- use_module(library(readutil)).\n\nmain :-\n    read_line_to_string(user_input, Line),\n    (   Line == end_of_file ->\n        true\n    ;   parse_t(Line, T) ->\n        process(T)\n    ;   true\n    ).\n\nparse_t(Line, T) :-\n    split_string(Line, \" \\t\\r\\n\", \" \\t\\r\\n\", [S]),\n    number_string(T, S).\n\nprocess(0).\nprocess(N) :-\n    N > 0,\n    read_line_to_string(user_input, S),\n    (   S == end_of_file ->\n        true\n    ;   check(S),\n        N1 is N - 1,\n        process(N1)\n    ).\n\ncheck(S) :-\n    (   valid(S) ->\n        write('YES')\n    ;   write('NO')\n    ),\n    nl.\n\nvalid(S) :-\n    split_string(S, \" \\t\\r\\n\", \" \\t\\r\\n\", [Clean]),\n    string_chars(Clean, Chars),\n    valid_chars(Chars, 0).\n\nvalid_chars([], 0).\nvalid_chars(['('|Rest], Bal) :-\n    Bal1 is Bal + 1,\n    valid_chars(Rest, Bal1).\nvalid_chars([')'|Rest], Bal) :-\n    Bal > 0,\n    Bal1 is Bal - 1,\n    valid_chars(Rest, Bal1).",
